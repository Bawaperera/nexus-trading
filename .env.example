# NEXUS AI Trading System — Environment Configuration
# ─────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your keys below
# 3. NEVER commit .env to git (it's in .gitignore)

# ── Binance API (required for live/paper trading) ──────
# Create at: https://www.binance.com/en/my/settings/api-management
# Permissions needed: Read + Spot Trading (NO withdrawals)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── CryptoPanic (optional — better crypto news) ────────
# Free API token at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=your_cryptopanic_token_here

# ── Trading configuration ───────────────────────────────
TRADING_SYMBOL=btcusdt          # Symbol to trade (binance format)
TRADING_TIMEFRAME=1h            # Candle interval: 1m 5m 15m 1h 4h 1d
TRADING_MODE=paper              # paper | live  (START WITH paper)
ACCOUNT_SIZE=1000               # Starting capital in USD
RISK_PCT=0.01                   # Risk per trade: 0.01 = 1%
MIN_CONFIDENCE=0.60             # Minimum model confidence to trade
