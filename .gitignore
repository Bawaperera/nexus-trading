# ── Python cache ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# ── Virtual environments ────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment / secrets ───────────────────────────────
# NEVER commit your real .env — it has API keys
.env
*.key
*.secret

# ── Test files with credentials ─────────────────────────
# test_telegram.py reads from .env so it's safe to keep,
# but gitignore it anyway to avoid accidents
test_telegram.py

# ── Trained ML models (large binary files) ─────────────
models/*.pkl
models/*.joblib
models/*.model
*.pkl
*.joblib

# ── Logs ────────────────────────────────────────────────
# Only ignore .log files — NOT the signals_log.csv or validation_log.csv
# Those CSVs are auto-committed by GitHub Actions every hour
logs/*.log
nexus.log

# ── Downloaded data cache ───────────────────────────────
data/cache/
nexus_dashboard_data.json

# ── IDE and OS files ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter notebooks ───────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Test artifacts ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/